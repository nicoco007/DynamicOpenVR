{
  "bindings": {
    "/actions/unity": {
      "haptics": [
        {
          "output": "/actions/unity/out/left_haptics",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/unity/out/right_haptics",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "poses": [
        {
          "output": "/actions/unity/in/left_grip_pose",
          "path": "/user/hand/left/pose/grip"
        },
        {
          "output": "/actions/unity/in/right_grip_pose",
          "path": "/user/hand/right/pose/grip"
        },
        {
          "output": "/actions/unity/in/left_aim_pose",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/unity/in/right_aim_pose",
          "path": "/user/hand/right/pose/tip"
        }
      ],
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/left_trigger_button"
            },
            "pull": {
              "output": "/actions/unity/in/left_trigger"
            },
            "touch": {
              "output": "/actions/unity/in/left_trigger_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/right_trigger_button"
            },
            "pull": {
              "output": "/actions/unity/in/right_trigger"
            },
            "touch": {
              "output": "/actions/unity/in/right_trigger_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/left_primary_2d_axis_click"
            },
            "position": {
              "output": "/actions/unity/in/left_primary_2d_axis"
            },
            "touch": {
              "output": "/actions/unity/in/left_primary_2d_axis_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/right_primary_2d_axis_click"
            },
            "position": {
              "output": "/actions/unity/in/right_primary_2d_axis"
            },
            "touch": {
              "output": "/actions/unity/in/right_primary_2d_axis_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/left_primary_button"
            },
            "touch": {
              "output": "/actions/unity/in/left_primary_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/right_primary_button"
            },
            "touch": {
              "output": "/actions/unity/in/right_primary_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/left_secondary_button"
            },
            "touch": {
              "output": "/actions/unity/in/left_secondary_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/right_secondary_button"
            },
            "touch": {
              "output": "/actions/unity/in/right_secondary_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/unity/in/left_grip"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/unity/in/right_grip"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/left_grip_button"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/right_grip_button"
            }
          }
        },
        {
          "path": "/user/hand/left/input/system",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/left_system_button"
            },
            "touch": {
              "output": "/actions/unity/in/left_system_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "force_sensor",
          "inputs": {
            "force": {
              "output": "/actions/unity/in/left_grip_force"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/unity/in/left_secondary_2d_axis"
            },
            "touch": {
              "output": "/actions/unity/in/left_secondary_2d_axis_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "force_sensor",
          "inputs": {
            "force": {
              "output": "/actions/unity/in/left_secondary_2d_axis_force"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/unity/in/right_secondary_2d_axis"
            },
            "touch": {
              "output": "/actions/unity/in/right_secondary_2d_axis_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "force_sensor",
          "inputs": {
            "force": {
              "output": "/actions/unity/in/right_secondary_2d_axis_force"
            }
          }
        },
        {
          "path": "/user/hand/right/input/system",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/right_system_button"
            },
            "touch": {
              "output": "/actions/unity/in/right_system_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "force_sensor",
          "inputs": {
            "force": {
              "output": "/actions/unity/in/right_grip_force"
            }
          }
        }
      ],
      "skeleton": [
        {
          "output": "/actions/unity/in/left_hand_animation",
          "path": "/user/hand/left/input/skeleton/left"
        },
        {
          "output": "/actions/unity/in/right_hand_animation",
          "path": "/user/hand/right/input/skeleton/right"
        }
      ]
    }
  },
  "controller_type": "knuckles"
}