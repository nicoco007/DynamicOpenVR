{
  "bindings": {
    "/actions/unity": {
      "chords": [],
      "poses": [
        {
          "output": "/actions/unity/in/left_pose",
          "path": "/user/hand/left/pose/grip"
        },
        {
          "output": "/actions/unity/in/right_pose",
          "path": "/user/hand/right/pose/grip"
        }
      ],
      "haptics": [
        {
          "output": "/actions/unity/out/left_haptics",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/unity/out/right_haptics",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "sources": [
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/left_grip_button"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/left_trigger_button"
            },
            "pull": {
              "output": "/actions/unity/in/left_trigger"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/left_primary_2d_axis_click"
            },
            "position": {
              "output": "/actions/unity/in/left_primary_2d_axis"
            },
            "touch": {
              "output": "/actions/unity/in/left_primary_2d_axis_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/right_grip_button"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/right_trigger_button"
            },
            "pull": {
              "output": "/actions/unity/in/right_trigger"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/right_primary_2d_axis_click"
            },
            "position": {
              "output": "/actions/unity/in/right_primary_2d_axis"
            },
            "touch": {
              "output": "/actions/unity/in/right_primary_2d_axis_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/system",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/left_select_button"
            }
          }
        },
        {
          "path": "/user/hand/right/input/system",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/right_select_button"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "scalar_constant",
          "inputs": {
            "value": {
              "output": "/actions/unity/in/left_grip"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "scalar_constant",
          "inputs": {
            "value": {
              "output": "/actions/unity/in/right_grip"
            }
          }
        },
        {
          "path": "/user/hand/left/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/left_menu_button"
            }
          }
        },
        {
          "path": "/user/hand/right/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/unity/in/right_menu_button"
            }
          }
        }
      ],
      "skeleton": [
        {
          "output": "/actions/unity/in/left_hand_animation",
          "path": "/user/hand/left/input/skeleton/left"
        },
        {
          "output": "/actions/unity/in/right_hand_animation",
          "path": "/user/hand/right/input/skeleton/right"
        }
      ]
    }
  },
  "controller_type": "vive_controller"
}